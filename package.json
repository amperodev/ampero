{
  "name": "ampero",
  "version": "0.2.0",
  "description": "Ampero: Edge-native L402 machine-to-machine micropayments and MCP gateway for AI agents on Cloudflare Workers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/wrapper.d.ts",
      "import": "./dist/mcp/wrapper.js",
      "default": "./dist/mcp/wrapper.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run test && npm run build",
    "quickstart": "tsx examples/quickstart.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "l402",
    "lsat",
    "lightning-network",
    "bitcoin",
    "mcp",
    "model-context-protocol",
    "cloudflare-workers",
    "micropayments"
  ],
  "author": "Ampero <ampero.dev@gmail.com>",
  "homepage": "https://ampero.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amperodev/ampero.git"
  },
  "bugs": {
    "url": "https://github.com/amperodev/ampero/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^3.109.2"
  },
  "dependencies": {
    "@getalby/sdk": "^8.0.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  }
}
